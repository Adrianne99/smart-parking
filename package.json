{
  "name": "smart-parking",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:keygen": "node -e \"require('fs').writeFileSync('supabase/signing_keys.json','[]')\" && supabase gen signing-key --algorithm ES256 --append",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
