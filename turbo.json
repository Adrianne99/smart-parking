{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate", "^generate"],
      "env": ["NEXT_PUBLIC_*", "EXPO_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["transit", "generate", "^generate"]
    },
    "typecheck": {
      "dependsOn": ["transit", "generate", "^generate"]
    },
    "test": {
      "dependsOn": ["transit", "generate", "^generate"],
      "env": ["TEST_DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
