# Copy (don't rename) to apps/api/.env for local development. Never commit .env files.
# Values are local Supabase CLI defaults (`pnpm db:start`), valid only on your machine.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API (scheme://host[:port], no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database + auth (required). Server-only: never put these in web/mobile env. ---
# Hosted later: DATABASE_URL = pooler connection string, DIRECT_URL = direct connection (migrations).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# JWTs are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_URL=http://127.0.0.1:54321

# --- Tests only. A throwaway database (name must end in _test); it is wiped on every test run. ---
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/smart_parking_test
