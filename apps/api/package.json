{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@smart-parking/config": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@smart-parking/contracts": "workspace:*",
    "@smart-parking/database": "workspace:*",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  }
}
