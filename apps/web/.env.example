# Copy to apps/web/.env.local. Never commit .env files.
# NEXT_PUBLIC_* values are embedded in the browser bundle: public values only, never secrets.

NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Phase P1 (auth). Publishable/anon key only; never the Supabase service-role or secret key. ---
# Local: URL below; key = "Publishable" from `pnpm db:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
