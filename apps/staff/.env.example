# Copy to apps/staff/.env.local. Never commit .env files.
# EXPO_PUBLIC_* values are compiled into the app binary: public values only, never secrets.

# Android emulator: http://10.0.2.2:4000 · physical device: http://<your-computer-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- Phase P1 (auth). Publishable/anon key only; never the Supabase service-role or secret key. ---
# Local: key = "Publishable" from `pnpm db:status`. On an emulator/device use 10.0.2.2 or your LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
